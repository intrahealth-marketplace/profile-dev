{"schemaVersion":1,"exportedAt":"2026-05-15T12:00:00.0000000+00:00","templates":[{"objGuid":"E5F6A7B8C9DA4E0044556677889900AA","name":"Telehealth Consent","description":"Informed consent for telehealth visit","type":1,"isActive":true,"presetsEnabled":true,"folderPath":["Consents"],"jsonDefinition":{"title":"Telehealth Consent","description":"Informed consent for telehealth visit","isActive":true,"fields":[{"id":"55555555-5555-4555-8555-555555555501","type":"info","name":"Patient","width":12,"content":"Patient","infoStyle":"success","validation":{"enabled":false}},{"id":"55555555-5555-4555-8555-555555555502","type":"text","name":"Patient Name","width":6,"autopopulation":{"enabled":true,"source":"patient","mode":"template","template":"{FirstName} {LastName}"}},{"id":"55555555-5555-4555-8555-555555555503","type":"date","name":"Date","width":3,"validation":{"enabled":false,"rules":{}}},{"id":"55555555-5555-4555-8555-555555555504","type":"info","name":"Consent","width":12,"content":"I understand that a telehealth visit uses electronic communications to enable a clinician to provide care without being in the same location as me. I understand the benefits and risks of telehealth, including that technology may fail and that not every condition can be evaluated remotely. I have had the opportunity to ask questions and consent to this visit.","validation":{"enabled":false}},{"id":"55555555-5555-4555-8555-555555555505","type":"radio","name":"Do you consent to the telehealth visit?","width":12,"options":[{"label":"Yes, I consent","value":"yes"},{"label":"No, I do not consent","value":"no"}],"required":true,"validation":{"enabled":false}},{"id":"55555555-5555-4555-8555-555555555506","type":"checkbox","name":"I confirm I am in a private location appropriate for this visit","width":12},{"id":"55555555-5555-4555-8555-555555555507","type":"signature","name":"Patient Signature","width":6,"validation":{"enabled":false}},{"id":"55555555-5555-4555-8555-555555555508","type":"signature","